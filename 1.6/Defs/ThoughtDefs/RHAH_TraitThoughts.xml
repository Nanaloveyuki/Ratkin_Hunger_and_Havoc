      <li>
        <label>独自留下</label>
        <description>篮子已经不在。今天没有人回来接我。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_CaptiveYear</defName>
    <durationDays>60</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>关了一年</label>
        <description>先看门，再看人。这一年就是这样过的。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
